@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - GestionLivres</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    <link rel="stylesheet" href="~/GestionLivres.styles.css" asp-append-version="true">
</head>
<body>

    <div class="container mt-4">
        <main role="main">
            <div class="text-center">
                <h1 class="display-4" >Dive into the World of Literary Brilliance</h1>
                <img src="https://cdn2.teebooks.com/4745-thickbox_default/etagere-pour-livre-60-x-15-cm-lot-de-6-acier.jpg" alt="Books Image" class="img-fluid mt-3" style="max-width: 100%;">
                <p class="mt-3">
                    Explore the world of books with GestionLivres. Whether you are a reader, an author, or an enthusiast, our platform offers a diverse collection of literary works. Immerse yourself in the pages of knowledge, stories, and imagination as you navigate through our curated selection of books, authors, and categories.
                </p>
            </div>
        </main>
    </div>

  

    

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

</body>
</html>
