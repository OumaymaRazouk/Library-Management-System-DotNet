@page
@model GestionLivres.Pages.CategorieModel
@{
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Liste des Auteurs</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <style>
        body {
            background: #f8f9fa; /* Light gray background color */
            font-family: 'Arial', sans-serif;
            margin: 0;
            padding: 20px;
        }

        h2 {
            color: #e44d26; /* A vibrant red-orange color */
        }

        table {
            width: 100%;
            margin-top: 20px;
            border-collapse: collapse;
        }

        th, td {
            padding: 12px;
            text-align: left;
            border-bottom: 1px solid #dee2e6; /* Bootstrap table border color */
        }

        tr:hover {
            background-color: #f5f5f5; /* Lighter gray on hover */
        }

        .btn-primary {
            background-color: #3498db; /* A vibrant blue color */
            border: 1px solid #3498db;
        }

        .btn-danger {
            background-color: #e74c3c; /* A vibrant red color */
            border: 1px solid #e74c3c;
        }
    </style>
</head>
<body>
<br>
<h2> liste des Categories</h2>
<a class='btn btn-primary btn-sm' href='/Categorie/createC'> Nouveau Categorie</a>
<table class="table">
    <thead>
        <tr>
            <th>ID </th>
            <th>Nom de Categorie </th>
            <th>Description </th>
           

        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.listCategorie)
        {
            <tr>
                <td>@item.IDCat</td>
                <td>@item.NomCat</td>
                <td>@item.DescriptionCat</td>
                


                <td>
                    <a class='btn btn-primary btn-sm' href='/Categorie/EditC?IDCat=@item.IDCat'> Modifier </a>
                    <a class='btn btn-danger btn-sm' href='/Categorie/DeleteC?IDCat=@item.IDCat'> Supprimer</a>
                </td>
            </tr>
        }
    </tbody>
</table>
</body>
</html>